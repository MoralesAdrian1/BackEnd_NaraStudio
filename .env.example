PORT=3000

# Proyecto de Supabase (público; con él se verifican los tokens de sesión)
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co

# Postgres local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nara_studio
DATABASE_SSL=false

# Supabase (Connect > ORMs > Prisma). Codifica en la URL los símbolos de la contraseña ($ → %24, # → %23, @ → %40).
# La app usa el pooler en modo transacción; las migraciones, el pooler en modo sesión.
# DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_SSL=true

# Secret key de Supabase (Project Settings > API Keys > Secret keys). Solo en el servidor: con ella
# se crean las cuentas de las alumnas que registra una coach.
SUPABASE_SECRET_KEY=
# Dirección de la app, para los enlaces de los correos
APP_URL=http://localhost:5173
# Correos con Resend (resend.com > API Keys). Sin key, los correos solo se escriben en el log.
RESEND_API_KEY=
# Remitente con tu dominio verificado en Resend
MAIL_FROM=Nara Studio <hola@tu-dominio.mx>

